{
  "uid": "swarmd-overview",
  "title": "swarmd · Run Overview",
  "description": "Golden signals for a swarmd run. Saturation here means someone else's rate limit, not our CPU.",
  "tags": ["swarmd", "golden-signals"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(swarmd_llm_calls_total, provider)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Saturation — the binding constraint",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Throughput vs. rate ceiling (req/min)",
      "description": "Configured supply is ~45 req/min across Groq and Google AI Studio. Sustained flatlining at the ceiling is the expected shape of a healthy saturated run, not an incident.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum by (provider) (rate(swarmd_llm_calls_total{provider=~\"$provider\"}[1m])) * 60",
          "legendFormat": "{{provider}}"
        },
        {
          "expr": "sum(rate(swarmd_llm_calls_total[1m])) * 60",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "red", "value": 45 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Rate-limit rejections (429/min)",
      "description": "Counted separately from errors on purpose: a 429 means the provider is working and we asked too fast. Conflating them trains people to ignore the error alert.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum by (provider) (rate(swarmd_rate_limited_total[1m])) * 60",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } }
      }
    },
    {
      "type": "stat",
      "title": "Providers available",
      "description": "0 means backed off. All providers at 0 simultaneously is the NoCapacity condition.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 9 },
      "targets": [
        { "expr": "swarmd_provider_available", "legendFormat": "{{provider}}" }
      ],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "BACKED OFF", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "OK", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Queue depth by stage",
      "description": "Rising depth with flat throughput means backpressure is doing its job — the run is degrading to fewer effective agents rather than dropping work.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 9 },
      "targets": [
        { "expr": "swarmd_queue_depth", "legendFormat": "{{stage}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Agents alive by state",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 9 },
      "targets": [
        { "expr": "swarmd_agents_alive", "legendFormat": "{{state}}" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 40 } }
      }
    },
    {
      "type": "row",
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "LLM latency p50 / p95 / p99",
      "description": "Buckets extend to 120s because free-tier providers routinely exceed the client default ceiling of 10s.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(swarmd_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{provider}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(swarmd_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{provider}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(swarmd_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p99 all"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "stat",
      "title": "Cache hit rate",
      "description": "Below 40% sustained, investigate prompt normalisation before adding provider capacity — the cache is a 2.5x capacity multiplier per the capacity plan.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "targets": [
        {
          "expr": "sum(rate(swarmd_cache_hits_total[5m])) / clamp_min(sum(rate(swarmd_cache_hits_total[5m])) + sum(rate(swarmd_llm_calls_total[5m])), 0.001)",
          "legendFormat": "hit rate"
        }
      ],
      "options": { "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.4 },
              { "color": "green", "value": 0.6 }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "Correctness and safety",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "type": "timeseries",
      "title": "Gate outcomes",
      "description": "Failures routing to repair rather than downstream is the whole point of the gate; a rising dead_letter rate is the signal that repair is not converging.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(swarmd_gate_outcomes_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 40 } }
      }
    },
    {
      "type": "timeseries",
      "title": "Red-team containments by pattern",
      "description": "Non-zero is healthy during a seeded-rogue run. Non-zero during an ordinary run is worth reading the audit trail for.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "sum by (pattern) (increase(swarmd_containments_total[5m]))",
          "legendFormat": "{{pattern}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kills and requeues",
      "description": "Requeues should track kills closely. A sustained gap means work is being lost rather than recovered.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "expr": "sum by (source) (rate(swarmd_agent_kills_total[1m])) * 60",
          "legendFormat": "kills · {{source}}"
        },
        {
          "expr": "sum(rate(swarmd_requeues_total[1m])) * 60",
          "legendFormat": "requeues"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Approvals pending",
      "description": "Outreach and skill entry both terminate here. This is a human queue, so it is expected to be non-zero.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 31 },
      "targets": [{ "expr": "swarmd_approvals_pending" }]
    },
    {
      "type": "timeseries",
      "title": "Approval wait p50 / p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 31 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(swarmd_approval_wait_seconds_bucket[30m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(swarmd_approval_wait_seconds_bucket[30m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
