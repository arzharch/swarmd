# swarmd local environment template — copy to .env and fill in.
# .env is gitignored. Never commit real keys: git history is forever and
# rotation cannot reach it.
#
#   cp .env.example .env
#   swarmd providers probe        # shows what capacity actually exists
#
# You do NOT need every key. The pool assembles capacity from whatever is
# present and skips the rest (see docs/CAPACITY.md). Zero keys is also a valid
# state — see SIMULATED MODE at the bottom.

# ---------------------------------------------------------------------------
# LLM providers — free tiers
# ---------------------------------------------------------------------------
# Recommended set for a full run: Groq + Google + Cerebras + OpenRouter.
# That is ~4 free accounts, no credit card, and roughly 4x the throughput of
# any one of them. Measured limits are in docs/CAPACITY.md.

# Groq — 30 req/min, 14,400 req/day. Fastest option (~700 tok/s on Llama 3.3
# 70B), which makes it the right default for high-volume worker steps.
# Get one: https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio — 15 req/min, 1,500 req/day, 1M context, Gemini 2.5 Flash.
# Lower volume but the strongest free quality, so it serves criterion authoring
# and judging where a weak model changes the outcome.
# Get one: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Cerebras — ~1M tokens/day, no card. The largest free daily quota available
# and the first provider to add when the rate-limit alert fires.
# Get one: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter — 20 req/min. Daily cap is documented inconsistently across
# sources (50 / 200 / 1000), which is exactly why the pool discovers real
# limits from observed 429s instead of trusting a constant.
# Get one: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral — ~1B tokens/month, the most generous free quota here.
# NOT USED unless SWARMD_ALLOW_DATA_TRAINING=true below, because that tier's
# quota is granted in exchange for consenting to have submitted prompts used
# for training. The price is paid in data rather than dollars, which should be
# a deliberate choice rather than a default.
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# Multiple credentials per provider (optional)
# ---------------------------------------------------------------------------
# Comma-separated. Each key becomes its own pool slot with its own quota
# bucket, because provider quota is per account (ADR-011).
#
# Legitimate use: separate keys per environment, or a team's shared accounts.
# NOT a rate-limit workaround — creating extra accounts to exceed quota
# violates most providers' terms and risks revocation mid-run. Cross-provider
# pooling plus the semantic cache gets the same multiple without the exposure.
# GROQ_API_KEYS=key_one,key_two
# GOOGLE_API_KEYS=

# ---------------------------------------------------------------------------
# Cost control
# ---------------------------------------------------------------------------
# Hard USD ceiling per run, enforced at the harness boundary. Breach aborts the
# run cleanly with an itemised report rather than truncating it, because a
# truncated run still emits numbers that look like results.
SWARMD_COST_CEILING_USD=0.05

# Admit the paid overflow tier (GLM 5.3 Flash) once free capacity is exhausted.
# With this false, running out of free capacity stops the run instead of
# quietly spending. The ceiling above still binds either way.
SWARMD_ALLOW_PAID=false

# Admit the Mistral free tier. See the MISTRAL_API_KEY note — this is consent
# to data training, not just a feature flag.
SWARMD_ALLOW_DATA_TRAINING=false

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Operator token. Gates every mutating endpoint and the event stream.
#
# This is NOT user auth. swarmd is single-tenant and operator-run: one person
# turns it on, submits work, and turns it off, so there is one principal and
# one credential (ADR-013). Building accounts and roles would be a login for a
# population of one.
#
# Optional on loopback so local work stays frictionless. REQUIRED to bind any
# other interface -- the service refuses to start otherwise, at startup rather
# than at first request, because the value of that check is entirely in when it
# happens.
#
#   openssl rand -hex 32
SWARMD_API_TOKEN=

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
# Postgres: checkpoints, cost ledger, HITL approvals, skill library, frozen
# criteria. Host port 5435 per docker-compose.yml — 5432/5433 and 5434 are
# taken by other stacks on this machine.
#
# `docker compose up -d postgres` first. The data lives in the named volume
# swarmd-postgres, so it survives `docker compose down`. Unset this and the
# approval store falls back to SQLite, which is durable across processes but
# single-writer -- fine locally, wrong for more than one replica.
DATABASE_URL=postgres://swarmd:swarmd_dev@localhost:5435/swarmd

# Redis: cluster-wide rate-limit quota (ADR-011). ONLY needed when more than
# one process shares a provider credential — i.e. Kubernetes. Leave unset for
# local single-process runs; the in-process token bucket is correct there and
# a network round trip to coordinate with yourself would be pointless.
# SWARMD_REDIS_URL=redis://localhost:6379/0

# OTel collector (Jaeger all-in-one via `docker compose up jaeger`).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Prometheus scrape port. docker-compose expects 9464.
SWARMD_METRICS_PORT=9464

# Structured logs for a collector that can index them. `plain` locally.
SWARMD_LOG_FORMAT=plain
SWARMD_LOG_LEVEL=INFO

# `dev` serves interactive API docs at /docs. Anything else disables them --
# they are a live client for every endpoint, served without the token.
SWARMD_ENV=dev

# ---------------------------------------------------------------------------
# SIMULATED MODE — development without provider keys
# ---------------------------------------------------------------------------
# Set this to run the full loop with no keys at all. It uses a deterministic
# synthetic provider so the pipeline, dashboard, chaos recovery, and metrics
# can all be developed before any real credential exists.
#
# It is NOT a quiet fallback, and it cannot be one:
#
#   * every ledger row it produces is stamped simulated=true
#   * every cost report built from those rows is stamped simulated=true
#   * the dashboard shows a persistent SIMULATED banner
#   * `swarmd eval` refuses to run at all
#   * a CI check fails the build if it appears in a prod manifest
#
# The reason for all of that: a dashboard fed by synthetic output is
# pixel-identical to one fed by real output (ADR-006). Fencing the config is
# not enough — the DATA carries the taint, so there is no path where simulated
# results are presented as real ones.
#
# Delete this line once you have a real key.
SWARMD_SIMULATED_PROVIDER=false
